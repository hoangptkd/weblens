# Public HTTPS URL and ACME account used by Caddy.
WEBLENS_PUBLIC_URL=https://weblens.example.com
ACME_EMAIL=admin@example.com

# Generated by CI in .release.env. Keep these placeholders for manual validation.
WEBLENS_IMAGE_REGISTRY=ghcr.io/your-github-owner
WEBLENS_IMAGE_TAG=0000000000000000000000000000000000000000

# Use URL-safe random values, for example: openssl rand -hex 32
POSTGRES_DB=weblens
POSTGRES_USER=weblens
POSTGRES_PASSWORD=replace-with-random-hex
CRAWLER_POSTGRES_DB=weblens_crawler
CRAWLER_POSTGRES_USER=weblens_crawler
CRAWLER_POSTGRES_PASSWORD=replace-with-random-hex
CAPTURE_POSTGRES_DB=weblens_capture
CAPTURE_POSTGRES_USER=weblens_capture
CAPTURE_POSTGRES_PASSWORD=replace-with-random-hex
CLICKHOUSE_DB=weblens_crawl_analytics
CLICKHOUSE_CAPTURE_DATABASE=weblens_capture_analytics
CLICKHOUSE_USER=weblens_runtime
CLICKHOUSE_PASSWORD=replace-with-random-hex
# Private Cloudflare R2 bucket. Create it before the first deployment and scope
# this token to Object Read & Write for this bucket only.
S3_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_CAPTURE_BUCKET=weblens-captures
S3_ACCESS_KEY=replace-with-r2-access-key-id
S3_SECRET_KEY=replace-with-r2-secret-access-key
WEBLENS_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
WEBLENS_JWT_SECRET=replace-with-base64-encoded-32-random-bytes

# Conservative single-VPS baseline. Raise only after measuring this VPS.
WEBLENS_SCAN_MAX_PAGES=1000
WEBLENS_SCAN_MAX_DEPTH=4
WEBLENS_SCAN_MAX_DURATION_SECONDS=3600
WEBLENS_SCAN_CONCURRENCY=32
CRAWLER_WORKER_CONCURRENCY=32
CRAWLER_HOST_CONCURRENCY=2
CRAWLER_HOST_DELAY=1s
CAPTURE_CONCURRENCY=2
CAPTURE_SITE_CLONE_CONCURRENCY=1
WEBLENS_HIKARI_MAX_POOL_SIZE=20
WEBLENS_HIKARI_MIN_IDLE=4
